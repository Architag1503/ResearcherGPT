# ==============================================================================
# RESEARCHERGPT GLOBAL CONFIGURATION
# ==============================================================================

# Express Backend (Gateway)
PORT=5000
MONGO_URI=mongodb://localhost:27017/researcher_gpt
REDIS_URL=redis://localhost:6379
AI_SERVICE_URL=http://localhost:8000
JWT_SECRET=dev_jwt_secret_token_key_12345!
NODE_ENV=development

# Clerk Auth Config
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Python FastAPI AI Service
AI_PORT=8000
QDRANT_HOST=localhost
QDRANT_PORT=6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=research_password_123

# LLM APIs
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
SAMBANOVA_API_KEY=your_sambanova_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
KIMI_API_KEY=your_kimi_api_key_here
SENSENOVA_API_KEY=your_sensenova_api_key_here

# Frontend Next.js Client
NEXT_PUBLIC_API_URL=http://localhost:5000

# Cloudflare R2 Object Storage
R2_ENDPOINT=https://your-cloudflare-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET_NAME=researcher-gpt
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
